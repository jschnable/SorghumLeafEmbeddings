vcf_sig <- vcf_sig[, c('CHROM', 'POS', 'ID', 'REF', 'ALT', indivs_keep)] %>%
pivot_longer(cols = !c(CHROM, POS, ID, REF, ALT),
names_to = 'genotype',
values_to = 'allele') %>%
filter(!(allele %in% c('1|0', '0|1'))) %>%
select(ID, genotype, allele) %>%
pivot_wider(id_cols = genotype,
names_from = ID,
values_from = allele)
