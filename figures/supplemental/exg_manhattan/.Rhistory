library(readxl)
cols <-c('time', 'firstName', 'lastName', 'email', 'department', 'institution', 'position', 'presentationFormat', 'title', 'authors', 'abstract',
'workshop', 'dietaryRestrictions', 'attendanceFormat', 'meals', 'email2', 'pronouns',
'v', 'x', 'y', 'z')
# Read in data and subset to fields relevant to abstract screening and filter to applications for talks
# Remove abstracts from faculty
# And from those intending to attend online
abstracts <- read.csv('../Downloads/npss - Form Responses 1.csv', col.names = cols) %>%
select(firstName, lastName, department, institution, position, presentationFormat, authors, abstract, attendanceFormat, pronouns, title) %>%
filter(str_detect(presentationFormat, 'Talk')) %>%
filter(position!="Faculty") %>%
filter(attendanceFormat=='In-person') %>%
rowwise() %>%
mutate(shortTalk = str_detect(presentationFormat, 'Short'))
# Create vectors to aggregate institutions
nonUSInstitutions <- c("University of Agriculture Faislabad ", "Indian agricultural research institute", "University of Karachi",
"CMS College, Mahatma Gandhi University, Kottayam, India")
sdsu <- c("South Dakota State University,Brookings", "South Dakota State University", "South Dakota State University, Brookings, SD",
"South Dakota State University ", " Geospatial Sciences Center of Excellence, Department of Geography and Geospatial Sciences, SDSU")
unl <- c("University of Nebraska-Lincoln ", "UNL", "IANR", "University of Nebraska-Lincoln", "PSI")
kstate <- c("Kansas State University ", "Kansas State University")
abstracts <- abstracts %>%
rowwise() %>%
mutate(institution = case_when(institution %in% nonUSInstitutions ~ 'Non-US Institution',
institution %in% sdsu ~ 'South Dakota State University',
institution %in% unl ~ 'University of Nebraska-Lincoln',
institution %in% kstate ~ 'Kansas State University',
.default = institution),
position = factor(position, levels = c("Undergraduate Student", "Graduate Student", "Post-Docs",
"Research Scholar")),
abstract= str_replace_all(abstract, '\n', '') %>%
str_replace_all('%', '\\%') %>%
str_replace_all(fixed('$'), '\\$')) %>%
# filter(institution!='Non-US Institution') %>%
arrange(desc(shortTalk), position, institution) %>%
ungroup() %>%
mutate(abstractID = 1:length(abstracts$abstract))
for(i in 1:34)
{
string <- paste0('\\abstractentry{', abstracts$abstractID[i], '}{', abstracts$position[i], '}{',
abstracts$institution[i], '}{', abstracts$title[i],'}{', abstracts$abstract[i], '} \n \n')
print(i)
print(string)
write_file(string,  'NPSSAbstracts.tex', append = TRUE)
}
write_file('\\end{document}',  'NPSSAbstracts.tex', append = TRUE)
write.csv(abstracts, 'talk_abstracts_clean.csv', row.names = FALSE, quote = TRUE)
flashtalks <- abstracts %>%
filter(str_detect(presentationFormat, 'Flash'))
View(abstracts)
abstracts %>% filter(abstractID %in% c(13, 7, 32, 26))
abstracts %>% filter(abstractID %in% c(13, 7, 32, 26, 5, 23))
abstracts %>% filter(abstractID %in% c(13, 7, 32, 26, 23)) %>% select(title, institution, abstractID)
abstracts %>% filter(abstractID %in% c(48, 7, 30, 32, 47, 38, 10, 19, 20, 25)) %>% select(title, institution, abstractID, firstName)
abstracts %>% filter(abstractID %in% c(48, 7, 30, 32, 47, 38, 10, 19, 20, 25)) %>% select(title, institution, abstractID, position)
